# Copy this file to `.env` in the backend/ folder for local development.
# On Render, set these as Environment Variables in the service dashboard instead.

# --- Core ---
APP_NAME=AI Voice Calling CRM
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1

# --- Database (MySQL) ---
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/ai_voice_crm

# --- Security / JWT (used by the Authentication module) ---
# Generate a strong SECRET_KEY, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# --- File storage ---
UPLOAD_DIR=uploads

# --- Gemini AI (Module 8) ---
# Get a key from https://aistudio.google.com/apikey — leave blank in
# development if you don't have one; AI endpoints will return a clear
# "not configured" error instead of the app failing to start.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_TEMPERATURE=0.4

# --- Voice Calling: Vapi + ElevenLabs (Module 9) ---
# Real Call mode only — leave blank to use Demo Call mode. Get a Vapi
# key + phone number id from https://dashboard.vapi.ai, and an
# ElevenLabs key + voice id from https://elevenlabs.io/app/settings/api-keys.
VAPI_API_KEY=d4111915-7aff-4589-8691-2fbbb56778b7
VAPI_API_BASE_URL=https://api.vapi.ai
VAPI_PHONE_NUMBER_ID=
VAPI_TIMEOUT_SECONDS=20
ELEVENLABS_API_KEY=•••••••••••••••••••••••••••••••••••••••••••••••ea30
ELEVENLABS_VOICE_ID=gHu9GtaHOXcSqFTK06ux

# Actual call length limit (Demo and Real), in seconds — not an API
# request timeout. Vapi is told to end Real calls at this duration.
MAX_CALL_DURATION_SECONDS=60

# Optional — verifies incoming Vapi webhook requests. Leave blank in
# development.
VAPI_WEBHOOK_SECRET=

# This backend's own public URL (e.g. your Render service URL), so
# Vapi knows where to send webhook events. Leave blank locally.
PUBLIC_BASE_URL=
